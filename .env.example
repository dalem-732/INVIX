# Скопируйте в .env и заполните перед запуском:
#   cp .env.example .env

POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

# Логин консоли MinIO (http://localhost:9001) и ключи доступа API.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_BUCKET=products

# Токен от @BotFather. Без него бот поднимает только /health и не ходит в Telegram.
BOT_TOKEN=
# Telegram user id администраторов через запятую.
ADMIN_IDS=
# Общий секрет бота и API. Заголовок X-Bot-Token на POST /products.
# Длинная случайная строка, не короткая фраза из примера:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SECRET=

# HTTPS-адрес каталога, который открывает кнопка Mini App.
# В браузере каталог доступен на http://localhost и без этой переменной.
WEBAPP_URL=https://example.com
# Публичный HTTPS-origin, куда Telegram шлёт вебхук: {PUBLIC_BASE_URL}/telegram/webhook
# Пустое значение - вебхук в Telegram не регистрируется, каталог в браузере работает.
PUBLIC_BASE_URL=
